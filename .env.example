# Application
PROJECT_NAME="FastAPI Boilerplate"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Database
# docker compose overrides POSTGRES_HOST to `db` for the api container
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# docker compose host port bindings
API_PORT=8000
TEST_POSTGRES_PORT=5433

# Optional: run pytest against the compose `db-test` service instead of SQLite
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test

# CORS (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
